max_value = 144
value = 60
step = 1

[node name="CloseButton" type="Button" parent="./Panel/VBoxContainer"]
text = "Close"
size_flags_horizontal = 3

[resource type="Script" id=1 path="res://scripts/ui/settings_menu.gd"]
